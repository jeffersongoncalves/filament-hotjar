{
    "name": "jeffersongoncalves/filament-hotjar",
    "description": "Filament plugin for Hotjar — tracking script injection and a Settings Page, powered by Spatie Laravel Settings, to manage your Hotjar site ID directly from your Filament panel.",
    "keywords": [
        "jeffersongoncalves",
        "laravel",
        "filament",
        "filament-plugin",
        "filament-hotjar",
        "hotjar",
        "heatmaps",
        "analytics",
        "spatie-laravel-settings"
    ],
    "homepage": "https://github.com/jeffersongoncalves/filament-hotjar",
    "license": "MIT",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "jeffersongoncalves/filament-analytics-core": "^3.1",
        "jeffersongoncalves/laravel-hotjar": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\Filament\\Hotjar\\": "src"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php ./vendor/bin/testbench icons:cache",
            "@php ./vendor/bin/testbench package:discover --ansi"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\Filament\\Hotjar\\HotjarServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\Filament\\Hotjar\\Tests\\": "tests"
        }
    }
}
